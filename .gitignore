# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# python parser
parser/.venv/
parser/.env
!parser/.env.example
parser/data/
__pycache__/

# typescript
*.tsbuildinfo
next-env.d.ts

# данные из Instagram: чужие фото и объявления, в git не храним
/public/ig/
/public/tg/
/src/data/instagram-listings.json

# локальные настройки Claude
.claude/

# счётчик просмотров сайта (локальный файл)
/.data/
