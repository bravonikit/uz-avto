# Образец настроек. Сам файл .env в git не попадает.
# Заполняется командой: python ig_api.py setup

IG_APP_ID=
IG_APP_SECRET=
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_TOKEN_EXPIRES=

# Архив на Google Диске (archive.py). Пусто = архив выключен
ARCHIVE_DIR=

# Telegram API (my.telegram.org → API development tools). Нужен для тяжёлых видео, см. tg_login.py
TG_API_ID=
TG_API_HASH=

# Telegram бот (tg_bot.py): токен от @BotFather, остальное заполнит python tg_bot.py setup
# Тот же токен и канал берёт сайт для кнопки «Опубликовать в канал» в /admin/daily
TG_BOT_TOKEN=
TG_ALERT_CHAT_ID=
TG_CHANNEL=
# 0 выключает сообщения часового прогона и видеопрогона в боте
TG_HOURLY=1
TG_VIDEO=1
